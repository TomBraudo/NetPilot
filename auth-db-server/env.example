# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Commands Server Configuration
# Local (when running backend2 locally):
COMMAND_SERVER_URL=
# Cloud (set via GitHub Secret COMMANDS_SERVER_URL in workflow):
COMMAND_SERVER_TIMEOUT=30

# Database Configuration
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_NAME=


# Flask Configuration
FLASK_ENV=development

SERVER_PORT=5000

# CORS Configuration
# Local dev origins:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Cloud origin (set via workflow):

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# HTTPS Configuration (for production)
USE_HTTPS=false
SECURE_COOKIES=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# 2FA Configuration
TOTP_ENCRYPTION_KEY=your_totp_encryption_key_here

# Logging Configuration
DB_ECHO=
LOG_LEVEL= 

# Scheduler Configuration
SCHEDULER_ENABLED=
SCHEDULER_TIMEZONE=
MAX_CONCURRENT_SCHEDULED_TASKS=
MIN_ROUTER_GAP_SECONDS=

# Chatbot Configuration
CHATBOT_KEY=your_openrouter_api_key_here
CHATBOT_MODEL=
CHATBOT_SYSTEM_PROMPT_URL=
OPENROUTER_API_URL=