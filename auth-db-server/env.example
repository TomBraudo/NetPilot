# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Commands Server Configuration
# Local (when running auth-db-server locally):
COMMAND_SERVER_URL=http://localhost:5000
# Cloud (set via GitHub Secret COMMANDS_SERVER_URL in workflow):
COMMAND_SERVER_TIMEOUT=30

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=netpilot_user
DB_PASSWORD=your_secure_password_here
DB_NAME=netpilot_db


# Flask Configuration
FLASK_ENV=development

SERVER_PORT=5000

# CORS Configuration
# Local dev origins:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Cloud origin (set via workflow):

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# HTTPS Configuration (for production)
USE_HTTPS=false
SECURE_COOKIES=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# 2FA Configuration
TOTP_ENCRYPTION_KEY=your_totp_encryption_key_here

# Logging Configuration
DB_ECHO=false
LOG_LEVEL=INFO

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
MAX_CONCURRENT_SCHEDULED_TASKS=5
MIN_ROUTER_GAP_SECONDS=30

# Chatbot Configuration
CHATBOT_KEY=your_openrouter_api_key_here
CHATBOT_MODEL=deepseek/deepseek-chat-v3.1:free
CHATBOT_SYSTEM_PROMPT_URL=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions