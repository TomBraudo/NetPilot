server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    include /etc/nginx/mime.types;

    location / {
        try_files $uri /index.html;
    }

    # Serve favicon for browsers requesting .ico, fallback to .png
    location = /favicon.ico {
        try_files /favicon.ico /favicon.png =404;
    }
}


